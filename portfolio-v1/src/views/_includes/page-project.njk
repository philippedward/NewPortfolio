<div class="container" data-project-page>
  <div class="row">
    <div class="col-1">
      <button data-project-return>
        <img src="/public/images/button-return.webp" alt="retour">
      </button>
    </div>
    <div class="col-1 offset-1">
      <div class="p-p-title">
        <h3>{{ project.title }}</h3>
        <p>{{ project["short-text"] }}</p>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-3">
      <img src="{{ project.image | url }}" alt="{{ project.title }}">
    </div>
  </div>

  <div class="row">
    {%
      set sections = [
        { title: project["description-title"], text: project["description-text"] },
        { title: project["purpose-title"], text: project["purpose-text"] },
        { title: project["idea-title"], text: project["idea-text"] }
      ]
    %}

    {% for section in sections %}
      <div class="col-1">
        <div class="p-p-text-col-{{ loop.index }}">
          <h3>{{ section.title }}</h3>
          <p>{{ section.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

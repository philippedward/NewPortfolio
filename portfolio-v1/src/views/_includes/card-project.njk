<a class="project-card" data-project-card href="/projets/{{ project.id }}/">
  <article>
    <div class="project-card-media">
      <img src="{{ project.image | url }}" alt="{{ project.title }}">
    </div>
    <div class="project-card-content">
      {% if project.title %}
        <h3>{{ project.title }}</h3>
      {% endif %}
      {% if project["short-text"] %}
        <p>{{ project["short-text"] }}</p>
      {% endif %}
    </div>
  </article>
</a>

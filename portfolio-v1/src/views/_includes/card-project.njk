<article class="spiral-card" data-project-card>
  <div class="spiral-card-media">
    <img src="{{ project.image | url }}" alt="{{ project.titre }}">
  </div>
  <div class="spiral-card-content">
    {% if project.titre %}
      <h3>{{ project.titre }}</h3>
    {% endif %}
    {% if project.description %}
      <p>{{ project.description }}</p>
    {% endif %}
  </div>
</article>

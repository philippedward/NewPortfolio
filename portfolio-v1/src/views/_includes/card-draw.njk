<article class="draw-card" data-draw-card>
  <div class="draw-card-media">
    <img src="{{ draw.image | url }}" alt="{{ draw.titre }}">
  </div>
  <div class="draw-card-content">
    {% if draw.titre %}
      <h3>{{ draw.titre }}</h3>
    {% endif %}
    {% if draw.description %}
      <p>{{ draw.description }}</p>
    {% endif %}
  </div>
</article>

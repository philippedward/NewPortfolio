<section class="draw-page" id="drawPage">
  <div class="container" data-draw-page>
    <div class="p-d-top">
      <div class="row">
        <div class="col-1">
          <button data-return>
            <img src="/public/images/hand-return.webp" alt="retour">
          </button>
        </div>
        <!-- // ============================================================
// section links and top text
// ============================================================ -->
        <div class="col-1">
          <p class="p-d-scroll" data-lang="fr">
            Scroller sur les côtés pour progresser dans le défilement de la
            page.
          </p>
          <p class="p-d-scroll" data-lang="en">
            Scroll sideways to move through the page.
          </p>
        </div>
        <div class="col-1">
          <div class="p-d-title">
            <div data-lang="fr">
              <h3>{{ draws.fr.title }}</h3>
              <p>{{ draws.fr["short-text"] }}</p>
              <p>{{ draws.fr["material-text"] }}</p>
            </div>
            <div data-lang="en">
              <h3>{{ draws.en.title or draws.fr.title }}</h3>
              <p>{{ draws.en["short-text"] or draws.fr["short-text"] }}</p>
              <p>
                {{ draws.en["material-text"] or draws.fr["material-text"] }}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- // ============================================================
// section zooming with the draw
// ============================================================ -->
    <div class="draw-zoom">
      <div class="row">
        <div class="col-3">
          <div class="p-d-box" data-zoom-box>
            <img
              src="{{ draws.image | url }}"
              alt="{{ draws.fr.title }}"
              data-zoom-img
              draggable="false"
            >

            <div class="zoom-controls">
              <button type="button" data-zoom-in>
                <img src="/public/images/hand-plus.webp" alt="zoom +">
              </button>
              <button type="button" data-zoom-out>
                <img src="/public/images/hand-minus.webp" alt="zoom -">
              </button>
            </div>
            <!-- // ============================================================
// section button return for reverse
// ============================================================ -->
            {% if draws.id == "draw-reverse" %}
              <button class="hand-rotate-btn" data-rotate type="button">
                <img src="/public/images/hand-rotate.webp" alt="rotation">
              </button>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
    <!-- // ============================================================
// section bottom text
// ============================================================ -->
    <div class="p-d-bottom">
      <div class="row">
        {%
          set sectionsFr = [
            { title: draws.fr["description-title"], text: draws.fr["description-text"] },
            { title: draws.fr["purpose-title"], text: draws.fr["purpose-text"] },
            { title: draws.fr["idea-title"], text: draws.fr["idea-text"] }
          ]
        %}
        {%
          set sectionsEn = [
            { title: draws.en["description-title"], text: draws.en["description-text"] },
            { title: draws.en["purpose-title"], text: draws.en["purpose-text"] },
            { title: draws.en["idea-title"], text: draws.en["idea-text"] }
          ]
        %}

        {% for section in sectionsFr %}
          <div class="col-1">
            <div class="{{ loop.index }}">
              <div class="p-d-section-draw">
                <div data-lang="fr">
                  <h3>{{ section.title }}</h3>
                  <p>{{ section.text }}</p>
                </div>
                <div data-lang="en">
                  <h3>{{ sectionsEn[loop.index0].title or section.title }}</h3>
                  <p>{{ sectionsEn[loop.index0].text or section.text }}</p>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="projects-spiral" id="projectStage">
  <div class="spiral-section">
    <div class="spiral">
      <div class="spiral-track" id="spiralTrack">
        <div class="center-text">
          <h2>Projets</h2>
        </div>
        {% for project in projects %}
          {% include "card-project.njk" %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<!-- // ============================================================
// section gallery
// ============================================================ -->
<section class="gallery-section" id="galleryStage">
  <div class="scene">
    <div class="wheel" id="wheelLeft"></div>
    <div class="wheel" id="wheelRight"></div>
    <div class="gallery-track" id="galleryTrack">
      <div class="center-text">
        <h2>Dessins</h2>
      </div>
      {% for draw in draws %}
        {% include "card-draw.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

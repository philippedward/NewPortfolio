---
layout: base.njk

---

{# ============================================================
   projet.njk — Page de détail d'un projet
   Ce layout est utilisé par projets.njk (pagination Eleventy).
   La variable "projet" est l'objet du fichier JSON du projet.
   Toutes les données sont affichées, avec des {% if %} pour
   les champs optionnels — c'est ça la logique conditionnelle.
   ============================================================ #}

<article
  class="project-card"
  data-project-card
  data-project-id="{{ item.id }}"
  data-project-title="{{ item.titre }}"
  data-project-image="{{ item.image | url }}"
>
  <a href="/projets/{{ item.id }}/" class="project-card-link">
    <figure class="project-card-figure">
      {% if item.image %}
        <img src="{{ item.image | url }}" alt="{{ item.titre }}" />
      {% else %}
        <img
          src="{{ '/images/icon-star.webp' | url }}"
          alt="{{ item.titre }}"
        />
      {% endif %}
      {% if item.description or item.titre %}
        <figcaption class="project-card-overlay">
          {% if item.titre %}
            <h3 class="project-card-title">{{ item.titre }}</h3>
          {% endif %}
          {% if item.description %}
            <p class="project-card-description">{{ item.description }}</p>
          {% endif %}
        </figcaption>
      {% endif %}
    </figure>
  </a>
</article>

---
layout: base.njk
title: Accueil
permalink: "/"

---

<!-- // ============================================================
// section projets : galerie
// ============================================================ -->
<section class="projects-spiral" id="spacer">
  <div class="stage">
    <div id="spiral">
      {% for item in projets %}
        {% include "card-project.njk" %}
      {% endfor %}
    </div>

    <div id="vignette-center"></div>
    <div id="vignette-edge"></div>

    <div id="center-text">
      <h1>Projets</h1>
    </div>

    <div id="scroll-hint">Scroll ↓</div>
  </div>
</section>

<!-- // ============================================================
// section drawings : galerie
// ============================================================ -->
<section class="drawings" id="deck">
  <div class="gallery-section">
    <div class="scene">
      <div class="gallery-track" id="galleryTrack">
        <div id="center-text">
          <h1>My Gallery</h1>
        </div>
        {% for item in draws %}
          {% include "card-draw.njk" %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<!-- // ============================================================
// section cv : galerie
// ============================================================ -->
<section class="cv" id="cv"></section>

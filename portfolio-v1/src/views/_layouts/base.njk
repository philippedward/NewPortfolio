<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Mon portfolio avec mes projets dessins et mon cv"
    />
    <link rel="icon" href="{{ '/public/images/icon-star.png' | url }}" />
    {# Le titre de la page est défini dans chaque page,
         avec un fallback sur config.titre #}
    <title>
      {% if title %}
        {{ title }}
        —
      {% endif %}
      {{ config.titre }}
    </title>
    <link rel="stylesheet" href="{{ '/assets/styles/main.css' | url }}" />
  </head>
  <body>
    <section>
      <header></header>
    </section>

    <main>
      {{ content | safe }}
    </main>

    <section>
      <footer></footer>
    </section>

    <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>
    {% block scripts %}{% endblock %}
  </body>
</html>

<article class="spiral-card" data-project-card>
  <div class="spiral-card-media">
    <img src="{{ item.image | url }}" alt="{{ item.titre }}">
  </div>
  <div class="spiral-card-content">
    {% if item.titre %}
      <h3>{{ item.titre }}</h3>
    {% endif %}
    {% if item.description %}
      <p>{{ item.description }}</p>
    {% endif %}
  </div>
</article>

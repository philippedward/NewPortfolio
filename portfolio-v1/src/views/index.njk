---
layout: base.njk
title: Accueil
permalink: "/"

---

<!-- // ============================================================
// section titre
// ============================================================ -->
<section>
  <div class="center-text">
    <h1 class="wave-title">
      <span>P</span><span>o</span><span>r</span><span>t</span><span
      >f</span><span>o</span><span>l</span><span>i</span><span>o</span>
    </h1>
    <p>Amélie Rakowiecki</p>
  </div>
</section>
<!-- // ============================================================
// section project
// ============================================================ -->
<section class="projects-spiral" id="projectStage">
  <div class="spiral-section">
    <div class="spiral">
      <div class="spiral-track" id="spiralTrack">
        <div class="center-text">
          <h2>Projets</h2>
        </div>
        {% for project in projects %}
          {% include "card-project.njk" %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<!-- // ============================================================
// section gallery
// ============================================================ -->
<section class="gallery-section" id="galleryStage">
  <div class="scene">
    <div class="wheel" id="wheelLeft"></div>
    <div class="wheel" id="wheelRight"></div>
    <div class="gallery-track" id="galleryTrack">
      <div class="center-text">
        <h2>Dessins</h2>
      </div>
      {% for draw in draws %}
        {% include "card-draw.njk" %}
      {% endfor %}
    </div>
  </div>
</section>
<!-- // ============================================================
// section cv
// ============================================================ -->
<section class="page-cv" id="cvStage">
  <div class="hand-wrapper" id="handWrapper">
    <img src="/public/images/hand-cv.webp" alt="Main" id="handImg">
  </div>
  <div class="cv-box" id="cvBox">
    <img
      class="cv-box-img"
      id="cvFinal"
      src="/public/images/CV.webp"
      alt="CV"
    >
    <img
      class="cv-box-img"
      id="cvPaper2"
      src="/public/images/cv-paper-2.webp"
      alt=""
    >
    <img
      class="cv-box-img"
      id="cvPaper3"
      src="/public/images/cv-paper-3.webp"
      alt=""
    >
  </div>
</section>
<!-- // ============================================================
// section scroll text
// ============================================================ -->
<div id="scroll-hint">Scroll ↓</div>

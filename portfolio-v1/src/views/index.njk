{# ============================================================
   index.njk — Page d'accueil
   Toutes les variables ci-dessous sont injectées automatiquement
   par Eleventy depuis les fichiers dans src/_data/ :
     - config        → config.json
     - projets       → projets.js (lit le dossier projets/)
     - encadrants    → encadrants.json  (variable = objet entier)
     - sections      → sections.json    (variable = objet entier)
     - interns       → interns.json     (variable = objet entier)
   ============================================================ #}
<!-- // ============================================================
// section projets : galerie
// ============================================================ -->
<section class="projects-spiral" id="spacer">
  <div id="stage">
    <div id="spiral"></div>
    <div id="vignette-center"></div>
    <div id="vignette-edge"></div>
    <div id="center-text">
      <h1>Projets</h1>
    </div>
    {% for projet in projets %}
      {% set item = projet %}
      {% include "card-project.njk" %}
    {% endfor %}
    <div id="scroll-hint">Scroll ↓</div>
  </div>
</section>

<!-- // ============================================================
// section drawings : galerie
// ============================================================ -->
<section class="drawings" id="deck">
  <div class="gallery-section">
    <div class="scene">
      <div class="gallery-track" id="galleryTrack">
        <div class="center-text">
          <h1>My Gallery</h1>
        </div>
        {% for item in draws %}
          {% include "card-draw.njk" %}
        {% endfor %}
      </div>
    </div>
    <div class="scroll-hint">Scroll ↓</div>
  </div>
</section>
<!-- // ============================================================
// section cv : galerie
// ============================================================ -->
<section class="cv" id="cv"></section>
